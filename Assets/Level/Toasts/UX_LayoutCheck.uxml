<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement style="flex-grow: 1; background-color: rgba(94, 94, 94, 0.44);">
        <ui:VisualElement name="ToastPanel" style="flex-grow: 1; position: absolute; top: 10%; left: 360px; width: auto; height: auto; right: 408px; background-image: url(&quot;project://database/Assets/Level/Toasts/ToastBackground.png?fileID=2800000&amp;guid=8ad55b002663ce74793e100fe7cafc25&amp;type=3#ToastBackground&quot;); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; scale: 1 1; bottom: 10%;">
            <ui:Label text="画面調整" parse-escape-sequences="true" style="top: 20%; align-items: center; -unity-text-align: upper-center; font-size: 50px; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); background-color: rgba(245, 245, 245, 0.38);"/>
            <ui:RadioButtonGroup label="画面サイズ" name="SizeGroup" choices="全画面,1920X1080" style="top: 30%; left: 20%; right: auto; font-size: 50px; -unity-font-style: normal;"/>
            <ui:Button text="保存" name="Accept" double-click-selects-word="false" triple-click-selects-line="false" style="position: absolute; top: 70%; left: 20%; font-size: 40px; color: rgb(255, 255, 255); background-color: rgb(255, 145, 100); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);"/>
            <ui:Button text="戻る" name="Reject" double-click-selects-word="false" triple-click-selects-line="false" style="position: absolute; top: 70%; left: auto; flex-grow: 1; width: auto; right: 20%; font-size: 40px; color: rgb(255, 147, 100); background-color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-font-style: bold;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
