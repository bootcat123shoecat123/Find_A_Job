    <ui:VisualElement style="flex-grow: 1; background-color: rgba(94, 94, 94, 0.44);">
        <ui:VisualElement name="ToastPanel" style="flex-grow: 1; position: absolute; top: 0%; left: 360px; width: auto; height: 100%; right: 408px; background-image: url(&quot;project://database/Assets/Level/Toasts/Texture/%E5%86%85%E5%AE%9A.jpg?fileID=2800000&amp;guid=da35701f0fffd7c4e83f7616421968b5&amp;type=3#内定&quot;); border-top-left-radius: 60px; border-top-right-radius: 60px; border-bottom-right-radius: 60px; border-bottom-left-radius: 60px; scale: 0 1; bottom: 0%; -unity-background-scale-mode: scale-and-crop;">
            <ui:Label text="" parse-escape-sequences="true" style="top: 20%; align-items: center; -unity-text-align: upper-center; font-size: 50px; color: rgb(0, 0, 0); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;);"/>
            <ui:Button text="転職サイトに戻る" name="B_Accept" double-click-selects-word="false" triple-click-selects-line="false" class="BAccept" style="position: absolute; top: 65%; left: 10%; font-size: 40px; color: rgb(255, 255, 255); background-color: rgb(255, 145, 100); -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
            <ui:Button text="もう一度" name="B_Reject" double-click-selects-word="false" triple-click-selects-line="false" display-tooltip-when-elided="false" selectable="false" focusable="false" class="BReject" style="position: absolute; top: 65%; left: auto; flex-grow: 1; width: auto; right: 20%; font-size: 40px; color: rgb(255, 147, 100); background-color: rgb(255, 255, 255); -unity-font-definition: url(&quot;project://database/Library/unity%20default%20resources?fileID=10102&amp;guid=0000000000000000e000000000000000&amp;type=0#LegacyRuntime&quot;); -unity-font-style: bold; border-left-color: rgb(255, 145, 100); border-right-color: rgb(255, 145, 100); border-top-color: rgb(255, 145, 100); border-bottom-color: rgb(255, 145, 100); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px;"/>
