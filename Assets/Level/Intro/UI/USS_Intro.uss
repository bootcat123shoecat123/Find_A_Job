:root {
}

.BStart {
    border-bottom-width: 2px;
    border-bottom-color: rgb(255, 255, 255);
}

.BQuit {
    border-bottom-width: 2px;
    border-bottom-color: rgb(248, 146, 25);
}

.BSetting {
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
}

.BSetting:hover {
    border-left-color: rgba(90, 157, 200, 0.65);
    border-right-color: rgba(90, 157, 200, 0.65);
    border-top-color: rgba(90, 157, 200, 0.65);
    border-bottom-color: rgba(90, 157, 200, 0.65);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
}

.BStart:hover {
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 0;
    border-left-width: 8px;
}

.BQuit:hover {
    border-left-color: rgb(248, 146, 25);
    border-right-color: rgb(248, 146, 25);
    border-top-color: rgb(248, 146, 25);
    border-bottom-color: rgb(248, 146, 25);
    border-top-width: 8px;
    border-right-width: 8px;
    border-bottom-width: 0;
    border-left-width: 8px;
}
