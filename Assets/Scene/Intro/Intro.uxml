<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="VisualElement" style="position: relative; width: 100%; height: 100%; background-color: rgb(215, 254, 255); background-image: url(&apos;project://database/Assets/Intro/Intro_city_image.jpg?fileID=2800000&amp;guid=5355968782c01b648b37f50d0a233ed3&amp;type=3#Intro_city_image&apos;);">
        <ui:VisualElement name="systembackground" style="left: 60%; width: 50%; height: 130%; top: -15%; bottom: 15%; position: absolute; background-color: rgba(255, 255, 255, 255); rotate: 15deg;" />
        <ui:Label text="就活シミュレーション" display-tooltip-when-elided="true" name="title" style="align-items: center; justify-content: center; -unity-text-align: upper-center; font-size: 80px; color: rgb(255, 255, 255); -unity-font-style: bold-and-italic; width: 1000px; top: 45%; transform-origin: bottom;" />
        <ui:Button text="就活スタート" display-tooltip-when-elided="true" name="start" style="left: 10%; justify-content: flex-end; align-items: center; right: 0; top: 50%; width: 30%; height: 10%; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; font-size: 40px; -unity-font: resource(&apos;FlatSkin/Font/Roboto-BoldItalic&apos;); -unity-font-style: bold; background-color: rgb(248, 146, 25); color: rgb(255, 255, 255);" />
        <ui:Button text="コンフィグ" display-tooltip-when-elided="true" name="config" style="left: 60%; justify-content: flex-end; align-items: center; right: 35%; top: 60%; width: 30%; height: 5%; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; font-size: 40px; -unity-font: resource(&apos;FlatSkin/Font/Roboto-BoldItalic&apos;); -unity-font-style: bold;" />
        <ui:Button text="逃げる" display-tooltip-when-elided="true" name="quit" style="left: 10%; justify-content: flex-end; align-items: center; right: 0; top: 50%; width: 30%; height: 5%; border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; font-size: 40px; -unity-font: resource(&apos;FlatSkin/Font/Roboto-BoldItalic&apos;); -unity-font-style: normal; background-color: rgba(255, 255, 255, 255); color: rgba(255, 162, 0, 255);" />
    </ui:VisualElement>
</ui:UXML>
